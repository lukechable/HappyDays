# ---- Next / public ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=            # from `npx convex dev` (https://<deployment>.convex.cloud)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---- Server only (Next) ----
CLERK_SECRET_KEY=
CONVEX_DEPLOYMENT=                 # written by `npx convex dev`, e.g. dev:happy-days-123
CONVEX_DEPLOY_KEY=                 # Railway only: production deploy key from the Convex dashboard

# ---- Set these on the CONVEX deployment (npx convex env set NAME value), not in Next ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev   (JWT template named "convex")
# ALLOWED_EMAILS=barbara@barbarafraser.net,luke@barbarafraser.net
# GOOGLE_CLIENT_ID=                (Internal OAuth app on the barbarafraser.net Workspace)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_PUBSUB_TOPIC=projects/<gcp-project>/topics/happydays-gmail
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=  (random string; appended to the push endpoint URL)
# TOKEN_ENCRYPTION_KEY=            (32 random bytes, base64; encrypts Google refresh tokens at rest)
# CLINIKO_API_KEY=                 (Luke's key; shard au1; subdomain barbara-fraser-and-associates)
# CLINIKO_SHARD=au1
# CLINIKO_SUBDOMAIN=barbara-fraser-and-associates
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# APP_URL=https://happydays.barbarafraser.net

# ---- Tyro Health (Convex only; obtain partner access before configuring) ----
# TYRO_ENV=prod                    (live Cliniko data is never sent to Tyro staging)
# TYRO_API_KEY=                    (business admin key; never expose to the client)
# TYRO_APP_ID=                     (issued by Tyro Health partnerships)
# TYRO_BUSINESS_ID=
# The HappyDays go-live cutoff is recorded once in the app at launch, not in an env var.
